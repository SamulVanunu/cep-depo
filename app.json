{
  "expo": {
    "name": "Cep Depo",
    "slug": "cep-depo",
    "scheme": "cepdepo",
    "version": "0.2.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.cepdepo.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101216"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cep Depo, profil fotoğrafı seçebilmeniz için fotoğraflarınıza erişir.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3701d37-83cf-4dbb-9ada-8284bbe343cc"
      }
    },
    "owner": "samuelvanunu34"
  }
}
