{
  "expo": {
    "name": "Cep Depo",
    "slug": "cep-depo",
    "scheme": "cepdepo",
    "version": "0.3.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.cepdepo.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101216"
      },
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111315",
          "image": "./assets/app-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#111315",
            "image": "./assets/app-icon.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cep Depo, profil fotoğrafı seçebilmeniz için fotoğraflarınıza erişir.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3701d37-83cf-4dbb-9ada-8284bbe343cc"
      }
    },
    "owner": "samuelvanunu34"
  }
}
